# Servicio del servidor de Kinhold (lo rellena instalar.sh). Arranca solo al encender la máquina y
# vuelve a arrancar si se cae. El mundo se guarda en /var/lib/kinhold (no se pierde al actualizar).
[Unit]
Description=Servidor del juego Kinhold
After=network-online.target
Wants=network-online.target

[Service]
User=kinhold
Group=kinhold
WorkingDirectory=@@DIR@@
# las cuentas de admin del panel de depuración (KINHOLD_ADMIN_CUENTA=…), si se han puesto (LEEME.md); sin ellas, la de valravnx
EnvironmentFile=-/etc/kinhold/admin.env
# la clave de Resend para mandar los códigos del correo de las cuentas (RESEND_API_KEY=…; LEEME.md); sin ella, los
# códigos van al registro del servidor (journalctl -u kinhold)
EnvironmentFile=-/etc/kinhold/correo.env
ExecStart=@@NODE@@ servidor/servidor.mjs @@PUERTO@@ /var/lib/kinhold/mundo.jsonl
Restart=always
RestartSec=3
StateDirectory=kinhold
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
