# Servicio del servidor de Kinhold (lo rellena instalar.sh). Arranca solo al encender la máquina y
# vuelve a arrancar si se cae. El mundo se guarda en /var/lib/kinhold (no se pierde al actualizar).
[Unit]
Description=Servidor del juego Kinhold
After=network-online.target
Wants=network-online.target

[Service]
User=kinhold
Group=kinhold
WorkingDirectory=@@DIR@@
ExecStart=@@NODE@@ servidor/servidor.mjs @@PUERTO@@ /var/lib/kinhold/mundo.jsonl
Restart=always
RestartSec=3
StateDirectory=kinhold
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
