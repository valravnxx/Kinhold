# Pone el servidor de Kinhold al día si en main hay una versión nueva de la demo (lo rellena instalar.sh; lo lanza
# kinhold-actualizar.timer cada 5 minutos). Ver servidor/nube/auto_actualizar.sh.
[Unit]
Description=Kinhold: poner el servidor al día con la última versión de la demo
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash @@DIR@@/servidor/nube/auto_actualizar.sh
