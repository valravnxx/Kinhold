# Copia de seguridad diaria del servidor de Kinhold (lo rellena instalar.sh; lo lanza kinhold-copia.timer una vez al
# día). Ver servidor/nube/copia.sh y LEEME.md («Copia de seguridad»). Como root: lee /var/lib/kinhold y la clave de
# /etc/kinhold. Si falla (o no hay destino fuera de la máquina), sale en «systemctl --failed».
[Unit]
Description=Kinhold: copia de seguridad del mundo, los objetos, las fichas y las cuentas
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash @@DIR@@/servidor/nube/copia.sh
