{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/**/*.js", "servidor/**/*.mjs", "herramientas/*.mjs", "pruebas/*.mjs", "*.mjs", "herramientas/comprobar/*.d.ts"],
  "exclude": ["node_modules", "**/node_modules", "docs", "src/**/dist"]
}
